%% =============================================================================
%% Iris Production Configuration
%% =============================================================================
%%
%% This is a ready-to-use production config. Override values via environment
%% variables or by editing this file directly.
%%
%% Required environment variables:
%%   IRIS_JWT_SECRET  - 32+ byte JWT signing secret (identical across all nodes)
%%   IRIS_COOKIE      - Erlang distribution cookie (identical across all nodes)
%%
%% Optional environment variables:
%%   IRIS_JWT_EDDSA_KEY - Ed25519 private key for EdDSA JWT signing
%%
%% Usage:
%%   make start CONFIG=config/production COOKIE=$IRIS_COOKIE
%%   make start DIST_MODE=name CONFIG=config/production COOKIE=$IRIS_COOKIE
%%
%% See also: docs/DEPLOYMENT.md, config/sys.config.example
%% =============================================================================

[
 {iris_core, [
    %% AUDIT MITIGATION P0-1 / P0-2: Production mode enables fail-fast validation.
    {deployment_mode, production},

    %% Database: auto-init on first node, join_seeds for subsequent
    {auto_init_db, true},
    %% MUST CONFIGURE: Seed nodes for cluster join (all nodes except the first).
    %% Example: ['iris_core@seed1', 'iris_core@seed2']
    %% WARNING: Empty list means this node bootstraps a NEW single-node cluster.
    {join_seeds, []},

    %% Presence: ETS for high performance (default)
    {presence_backend, ets},

    %% Multi-region: set to actual region for this node
    {region_id, <<"us-east">>},
    {regions, [<<"us-east">>, <<"us-west">>, <<"eu">>]},

    %% Durability: sync_transaction across majority (RPO=0)
    {multimaster_durability, true},
    {durability_mode, quorum},

    %% Replication
    {replication_factor, 3},

    %% AUDIT MITIGATION P0-2: All cluster node names for split-brain detection.
    %% MUST be configured with actual node names before deployment.
    {expected_cluster_nodes, ['iris_core@core1', 'iris_core@core2', 'iris_core@core3']},

    %% mTLS inter-node (NFR-15)
    {enforce_mtls, true},

    %% Consistency mode (only hardened_ap is implemented)
    {consistency_mode, hardened_ap},

    %% Health check port (shared with edge if co-located)
    {health_port, 9090},

    %% Metrics endpoint bearer token (required in production)
    {metrics_bearer_token, <<"REPLACE_WITH_METRICS_TOKEN">>}
 ]},

 {iris_edge, [
    %% AUDIT MITIGATION P0-1 / P0-2: Production mode enables fail-fast validation.
    {deployment_mode, production},

    %% Listening port
    {port, 8085},

    %% Authentication: MUST be enabled in production
    {auth_enabled, true},

    %% JWT secret: prefer IRIS_JWT_SECRET env var over this setting.
    %% If using config file, replace with your actual 32+ byte secret.
    %% {jwt_secret, <<"REPLACE_WITH_32_BYTE_SECRET_KEY!!">>},

    %% Auth mode: signer (can create+validate tokens) or verifier (validate only)
    {auth_mode, verifier},

    %% TLS: REQUIRED in production (RFC NFR-14)
    {tls_enabled, true},
    {allow_insecure, false},
    {tls_cacertfile, "/etc/iris/certs/ca.pem"},
    {tls_certfile, "/etc/iris/certs/server.pem"},
    {tls_keyfile, "/etc/iris/certs/server-key.pem"},
    {tls_verify, verify_peer},

    %% AUDIT MITIGATION P0-2: Core nodes for message routing.
    %% MUST be configured with actual node names before deployment.
    {core_nodes, ['iris_core@core1', 'iris_core@core2']},

    %% Connection rate limit (RFC Section 10.1: 5/min/IP)
    {conn_rate_max, 5},

    %% Rate limiting
    {rate_limit_default, 10000},
    {rate_burst_default, 50000},

    %% Health check port
    {health_port, 9090},

    %% Graceful shutdown drain time (ms)
    {shutdown_drain_ms, 10000}
 ]},

 {kernel, [
    %% Production log level: notice (info is too verbose, warning misses important events)
    {logger_level, notice},

    %% Structured JSON logging for production (ELK/Loki/CloudWatch compatible)
    {logger, [
        {handler, default, logger_std_h, #{
            formatter => {iris_json_formatter, #{}}
        }}
    ]}
 ]}
].
