%% =============================================================================
%% Test Configuration with Authentication Enabled (CFG-001 FIX)
%% =============================================================================
%% Use this config for security tests that need to validate JWT authentication.
%% Enables auth_enabled=true so JWT security tests exercise live validation.
%%
%% To use: IRIS_CONFIG=config/test_auth make test-security
%% =============================================================================

[
 {iris_core, [
    {join_seeds, []},
    {auto_init_db, true},
    
    %% Lockfree presence (eliminates global lock)
    {presence_backend, ets},
    
    %% Data safety: NEVER auto-delete corrupted tables in tests
    {allow_table_nuke, false},
    
    %% Quorum writes: default replication factor
    {replication_factor, 3},
    
    %% Regional routing: single region for local tests
    {region_id, <<"local">>},
    {regions, []},
    
    %% Consistency mode
    {consistency_mode, hardened_ap},
    
    %% Durability mode for offline message storage
    {durability_mode, local}
 ]},
 {iris_edge, [
    {core_nodes, []},
    {allow_insecure, true},  %% Still allow plaintext for non-TLS tests
    
    %% =======================================================================
    %% CFG-001 FIX: Authentication ENABLED
    %% =======================================================================
    %% JWT configuration for security testing
    {jwt_secret, <<"test_secret_key_for_auth_testing_ci_only_32bytes!">>},
    {jwt_algorithm, hs256},
    {jwt_ttl, 3600},           %% 1 hour token validity
    {jwt_issuer, <<"iris_test">>},
    
    %% ENABLED for security test suite
    {auth_enabled, true},
    
    %% Token revocation checking
    {check_revocation, true},
    
    %% Rate limiting for auth endpoints
    {auth_rate_limit, 100},     %% 100 auth attempts/second
    {auth_lockout_threshold, 10}, %% Lock after 10 failed attempts
    {auth_lockout_duration, 60}   %% 60 second lockout
 ]}
].
