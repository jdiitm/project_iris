%% Docker Cluster Configuration
%% Multi-region setup for cross-region chaos testing

[
 {iris_core, [
    %% Presence backend (ETS for high performance)
    {presence_backend, ets},
    
    %% Auto-initialize DB on first node
    {auto_init_db, true},
    
    %% Multi-region configuration
    %% Regions are: us-east, us-west, eu
    {regions, [<<"us-east">>, <<"us-west">>, <<"eu">>]},
    
    %% Default region (overridden per-node via command line)
    {region_id, <<"us-east">>},
    
    %% Region endpoints (core nodes for each region)
    {region_endpoints, #{
        <<"us-east">> => [core_east_1@coreeast1, core_east_2@coreeast2],
        <<"us-west">> => [core_west_1@corewest1, core_west_2@corewest2],
        <<"eu">> => [core_eu_1@coreeu1, core_eu_2@coreeu2]
    }},
    
    %% Multimaster durability (sync_transaction for RPO=0)
    {multimaster_durability, true}
 ]},
 
 {iris_edge, [
    %% Default port (overridden per-node)
    {port, 8085},
    
    %% Authentication disabled for testing
    {auth_enabled, false},
    
    %% TLS enabled with certificates
    {tls_enabled, true},
    {tls_cacertfile, "/app/certs/ca.pem"},
    %% Certificate and key are set per-node via command line
    
    %% Core nodes to connect to (essential for message routing)
    {core_nodes, [
        core_east_1@coreeast1, core_east_2@coreeast2,
        core_west_1@corewest1, core_west_2@corewest2,
        core_eu_1@coreeu1, core_eu_2@coreeu2
    ]},
    
    %% Regions config for cross-region routing
    {regions, [<<"us-east">>, <<"us-west">>, <<"eu">>]},
    {region_id, <<"us-east">>},
    {region_endpoints, #{
        <<"us-east">> => [core_east_1@coreeast1, core_east_2@coreeast2],
        <<"us-west">> => [core_west_1@corewest1, core_west_2@corewest2],
        <<"eu">> => [core_eu_1@coreeu1, core_eu_2@coreeu2]
    }}
 ]},
 
 {kernel, [
    {logger_level, notice}
 ]}
].
