%% =============================================================================
%% Test Configuration with TLS Enabled (CFG-002 FIX)
%% =============================================================================
%% Use this config for TLS enforcement tests (RFC NFR-14 compliance).
%% Enables TLS and rejects plaintext connections.
%%
%% Prerequisites:
%%   - Generate certs: cd certs && ./generate_certs.sh
%%   - Certs must exist: certs/edge-east-1.{pem,key}, certs/ca.pem
%%
%% To use: IRIS_CONFIG=config/test_tls make test-security
%% =============================================================================

[
 {iris_core, [
    {join_seeds, []},
    {auto_init_db, true},
    {allow_schema_delete, true},
    
    %% Lockfree presence
    {presence_backend, ets},
    
    %% Partition detection
    {expected_cluster_nodes, []}
 ]},
 {iris_edge, [
    %% Connect to local Core node for message routing
    %% The Core node is started with -sname iris_core
    {core_nodes, ['iris_core@j']},
    
    %% Standard test port (most tests expect 8085)
    {port, 8085},
    
    %% =======================================================================
    %% CFG-002 FIX: TLS Configuration (RFC NFR-14 Compliance)
    %% =======================================================================
    %% TLS is MANDATORY per RFC NFR-14 for production
    %% This config enforces TLS for all client connections
    {allow_insecure, false},
    {tls_enabled, true},
    
    %% Certificate paths (relative to project root)
    %% Using edge-east-1 cert which is signed by our test CA
    {tls_certfile, "certs/edge-east-1.pem"},
    {tls_keyfile, "certs/edge-east-1.key"},
    {tls_cacertfile, "certs/ca.pem"},
    
    %% TLS options
    {tls_verify, verify_none},  %% For testing (production: verify_peer)
    {tls_versions, ['tlsv1.3', 'tlsv1.2']},
    
    %% Cipher suites (strong only)
    {tls_ciphers, [
        "TLS_AES_256_GCM_SHA384",
        "TLS_AES_128_GCM_SHA256",
        "TLS_CHACHA20_POLY1305_SHA256"
    ]},
    
    %% Authentication (disabled for TLS-only tests)
    {auth_enabled, false},
    
    %% JWT secret: Required by iris_auth gen_server at startup.
    %% Must be ≥32 bytes. Matches test.config for consistency.
    {jwt_secret, <<"test_secret_key_for_testing_only">>},
    
    %% Per-IP connection rate limiting (RFC Section 10)
    %% High value for stress tests; test_connection_scale needs 1000+ from
    %% localhost. The dedicated rate_limit test sets its own value via RPC.
    %% Production default is 50/sec (see iris_edge_listener.erl).
    {conn_rate_max, 5000},
    
    %% Per-user message rate limiting (RFC Section 10.1)
    %% High values for stress/performance tests. Production default is
    %% 5 msg/sec sustained / 20 burst (see iris_rate_limiter.erl).
    {rate_limit_default, 10000},
    {rate_burst_default, 50000}
 ]}
].

