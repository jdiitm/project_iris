%% =============================================================================
%% Project Iris: mTLS-Enabled Test Configuration (CFG-002 FIX)
%% =============================================================================
%% This configuration enforces mutual TLS for all inter-node communication.
%% Client certificate is REQUIRED (mutual authentication).
%%
%% Usage:
%%   Docker:     make cluster-mtls (uses /app/certs paths)
%%   Local:      IRIS_CONFIG=config/test_mtls make test-security
%%
%% Prerequisites:
%%   - Generate certs: cd certs && ./generate_certs.sh
%%   - Ensure test-client.{pem,key} exists for client auth testing
%% =============================================================================

[
 {kernel, [
   %% Erlang distribution over TLS
   {inet_dist_use_interface, {0,0,0,0}},
   {net_ticktime, 30}
 ]},

 {iris_core, [
   %% Core node settings
   {auto_init_db, true},
   {join_seeds, []},
   {allow_schema_delete, true},
   
   %% Lockfree presence
   {presence_backend, ets},
   
   %% Partition detection
   {expected_cluster_nodes, []},
   
   %% mTLS settings for inter-node RPC
   {mtls_enabled, true},
   %% Use relative paths for local testing, Docker compose overrides these
   {mtls_ca, "certs/ca.pem"},
   {mtls_verify, verify_peer},
   {mtls_depth, 2}
 ]},

 {iris_edge, [
   %% Edge node settings  
   {tls_enabled, true},
   {allow_insecure, false},
   
   %% Client-facing TLS (server cert)
   %% Relative paths for local testing
   {tls_certfile, "certs/edge-east-1.pem"},
   {tls_keyfile, "certs/edge-east-1.key"},
   {tls_cacertfile, "certs/ca.pem"},
   
   %% mTLS: REQUIRE client certificate (mutual authentication)
   {tls_verify, verify_peer},
   {tls_fail_if_no_peer_cert, true},
   
   %% mTLS for Edge->Core communication
   {mtls_enabled, true},
   {mtls_certfile, "certs/edge-east-1.pem"},
   {mtls_keyfile, "certs/edge-east-1.key"},
   {mtls_cacertfile, "certs/ca.pem"},
   {mtls_verify, verify_peer},
   
   %% Core node discovery (local standalone: connect to co-located core)
   {core_nodes, ['iris_core@j']},
   
   %% Auth disabled for mTLS-focused testing
   {auth_enabled, false},
   
   %% JWT secret: Required by iris_auth gen_server at startup.
   %% Must be ≥32 bytes. Matches test.config for consistency.
   {jwt_secret, <<"test_secret_key_for_testing_only">>},
   
   %% Rate limits: High values for testing (not the focus of mTLS tests)
   {conn_rate_max, 5000},
   {rate_limit_default, 10000},
   {rate_burst_default, 50000}
 ]},

 {ssl, [
   %% TLS 1.3 only (RFC NFR-14 compliance)
   {versions, ['tlsv1.3', 'tlsv1.2']},
   
   %% Strong cipher suites
   {ciphers, [
     "TLS_AES_256_GCM_SHA384",
     "TLS_CHACHA20_POLY1305_SHA256",
     "TLS_AES_128_GCM_SHA256"
   ]},
   
   %% Certificate verification - STRICT
   {verify, verify_peer},
   {fail_if_no_peer_cert, true},
   {depth, 2}
 ]}
].

