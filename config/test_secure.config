%% =============================================================================
%% Iris Secure Test Configuration (B-3 AUDIT MITIGATION)
%% =============================================================================
%% This config mirrors production security settings for CI security validation.
%% Used by the CI security tier to ensure TLS and auth are actually tested.
%%
%% Differences from test.config:
%%   - auth_enabled = true  (RFC FR-9/NFR-16)
%%   - tls_enabled = true   (RFC NFR-14)
%%   - allow_insecure = false
%%   - deployment_mode = production (triggers fail-fast validation)
%% =============================================================================

[
 {iris_core, [
    {join_seeds, []},
    {auto_init_db, true},
    {presence_backend, ets},
    {allow_table_nuke, false},
    {replication_factor, 3},
    {region_id, <<"local">>},
    {regions, []},
    {consistency_mode, hardened_ap},
    {durability_mode, local},
    %% B-3: Production mode for fail-fast validation
    {deployment_mode, production},
    {expected_cluster_nodes, []}
 ]},
 {iris_edge, [
    {core_nodes, []},
    %% B-3: TLS enabled (RFC NFR-14)
    {tls_enabled, true},
    {allow_insecure, false},
    {tls_certfile, "certs/server.pem"},
    {tls_keyfile, "certs/server-key.pem"},
    {tls_cacertfile, "certs/ca.pem"},
    %% B-3: Auth enabled (RFC FR-9/NFR-16)
    {jwt_secret, <<"test_secure_secret_key_32_bytes!">>},
    {auth_enabled, true},
    {auth_mode, signer}
 ]}
].
