%% Development/default sys.config for OTP release
[
 {iris_core, [
    {deployment_mode, development},
    {auto_init_db, true},
    {join_seeds, []},
    {presence_backend, ets},
    {consistency_mode, hardened_ap},
    {health_port, 9090}
 ]},

 {iris_edge, [
    {deployment_mode, development},
    {port, 8085},
    {auth_enabled, false},
    {auth_mode, verifier},
    {tls_enabled, false},
    {health_port, 9090},
    {shutdown_drain_ms, 5000}
 ]},

 {kernel, [
    {logger_level, info}
 ]}
].
