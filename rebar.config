%% =============================================================================
%% Project Iris - rebar3 Configuration
%% =============================================================================
%% SW-3: OTP release packaging via relx
%% =============================================================================

%% Strict compilation: all warnings are errors.
%% Unused variables have been cleaned up — do not regress.
{erl_opts, [debug_info, warnings_as_errors]}.

{deps, []}.

%% Umbrella layout: each OTP app in its own directory under apps/.
%% The apps/ dirs are created by CI before `rebar3 release`.
%% Local Makefile builds use src/ directly (unchanged).
{project_app_dirs, ["apps/*"]}.

{relx, [
    {release, {iris, "0.1.0"}, [
        iris_core,
        iris_edge,
        mnesia,
        crypto,
        ssl,
        os_mon,
        sasl
    ]},
    {dev_mode, false},
    {include_erts, true},
    {extended_start_script, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true},
            {sys_config, "config/production.config"},
            {vm_args, "config/vm.args.prod"}
        ]}
    ]}
]}.
