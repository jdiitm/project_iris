# =============================================================================
# Project Iris - Cluster Node Image
# =============================================================================
# Extended erlang:26-alpine with tools required for testing:
# - libfaketime: Required for NFR-16 (Clock Skew Tolerance) testing
# - procps: For process monitoring
# - NET_ADMIN tools: For network partition testing
# =============================================================================

FROM erlang:26-alpine

# Install testing tools
# libfaketime is REQUIRED for RFC NFR-16 clock skew verification
# curl is REQUIRED for Docker healthcheck (curl -sf http://localhost:9090/ready)
RUN apk add --no-cache \
    libfaketime \
    procps \
    iptables \
    iproute2 \
    bash \
    curl \
    zstd-dev \
    gcc \
    musl-dev \
    && rm -rf /var/cache/apk/*

# Verify libfaketime is installed correctly
RUN ls -la /usr/lib/faketime/ || echo "Warning: faketime lib path may vary"

WORKDIR /app
