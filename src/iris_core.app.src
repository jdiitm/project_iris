{application, iris_core,
 [{description, "Iris Core Node"},
  {vsn, "0.3.0"},
  {modules, [
    iris_core,
    iris_cluster_manager,
    iris_health_handler,
    iris_core_registry,
    iris_dedup,
    iris_durable_batcher,
    iris_durable_batcher_sup,
    iris_efficiency_monitor,
    iris_flow_controller,
    iris_group,
    iris_group_fanout,
    iris_hlc,
    iris_json_formatter,
    iris_keys,
    iris_limits,
    iris_mailbox_guard,
    iris_mailbox_monitor,
    iris_metrics,
    iris_mnesia_guard,
    iris_offline_storage,
    iris_partition_guard,
    iris_presence,
    iris_quorum_write,
    iris_read_receipts,
    iris_region_bridge,
    iris_region_router,
    iris_shard,
    iris_status_batcher,
    iris_status_batcher_sup,
    iris_store,
    iris_user_safety,
    iris_rpc,
    iris_cluster_join_worker,
    iris_discovery,
    %% Shared modules (used by both core and edge)
    iris_proto,
    iris_ratchet,
    iris_sender_keys,
    iris_uuid,
    iris_x3dh,
    iris_zstd_nif
  ]},
  {registered, [iris_core]},
  {applications, [kernel, stdlib, mnesia]},
  {mod, {iris_core, []}},
  {env, [{auto_init_db, true}]}
 ]}.
