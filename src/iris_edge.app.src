{application, iris_edge,
 [{description, "Iris Edge Node"},
  {vsn, "0.3.0"},
  {modules, [
    iris_edge_app,
    iris_edge_sup,
    iris_edge_listener,
    iris_edge_conn,
    iris_edge_dedup_cleaner,
    iris_edge_fallback_drain,
    %% iris_health_handler provided by iris_core (shared module)
    iris_session,
    iris_ws_lite,
    iris_compression,
    iris_auth,
    iris_auth_json,
    iris_async_router,
    iris_backpressure,
    iris_cert_monitor,
    iris_circuit_breaker,
    %% iris_discovery removed — provided by iris_core app
    iris_ingress_byte_guard,
    iris_ingress_guard,
    iris_rate_limiter,
    iris_registry_ets,
    iris_router,
    iris_router_sup,
    iris_router_worker,
    iris_session_cache,
    iris_trace
  ]},
  {registered, [iris_edge_app]},
  %% NOTE: iris_core runs on separate node(s) — NOT listed as dependency.
  %% Edge communicates with Core via RPC (iris_rpc module).
  {applications, [kernel, stdlib, ssl]},
  {mod, {iris_edge_app, []}},
  {env, [
      {port, 8080},
      {auth_enabled, true},
      {allow_insecure, false},
      {tls_enabled, true}
  ]}
 ]}.
